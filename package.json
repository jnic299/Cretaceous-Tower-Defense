{
  "name": "cretaceous-tower-defense",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Cretaceous Tower Defense — hold the perimeter against the horde.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
